_eval_counter = [0]


def make_evaluate_fast_physical(
    qubit,
    x90_amp,
    leak_freqs_mhz,
    meta_dict,
    fast_circuit_depths,
    shots,
    num_circuits,
    calib_params,
    outer_folder,
):
    n_cma_params = 4 + 2 * len(leak_freqs_mhz)
    train_seed = RB_TRAIN_SEED if USE_FIXED_TRAIN_SEED else None

    def evaluate(x):
        _eval_counter[0] += 1
        label = f"cma_iter_{_eval_counter[0]:04d}"

        feedback_metric, probs = run_rb_fast_feedback_physical_x(
            x=x,
            qubit=qubit,
            x90_amp=x90_amp,
            leak_freqs_mhz=leak_freqs_mhz,
            meta_dict=meta_dict,
            fast_circuit_depths=fast_circuit_depths,
            shots=shots,
            num_circuits=num_circuits,
            calib_params=calib_params,
            outer_folder=outer_folder,
            iteration_label=label,
            rb_seed=train_seed,
        )

        cost = 1.0 - feedback_metric
        probs_str = ", ".join([f"{p:.4f}" for p in probs])
        print(
            f"[{label}]  decay_p={feedback_metric:.8f}  cost={cost:.8e}  "
            f"P(depths)=[{probs_str}]"
        )
        return cost

    return evaluate, n_cma_params


