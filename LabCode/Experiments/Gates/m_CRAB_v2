def add_x90_oc_to_config(
    config, q_name, crab_wf_I_X, crab_wf_Q_X, crab_wf_I_Y, crab_wf_Q_Y
):
    """
    Add X90_OC, mX90_OC, Y90_OC, mY90_OC operations to q_name in the config.

    Input correction waveforms are physical-channel corrections:
      X90_OC : X90_I + crab_I_X,  X90_Q + crab_Q_X
      Y90_OC : Y90_I + crab_I_Y,  Y90_Q + crab_Q_Y

    The negative gates are exact negatives of the optimized positive gates.
    """
    # X90: I <- X90_wf_, Q <- X90_wf_der_
    x90_I = np.asarray(config["waveforms"]["X90_wf_" + q_name]["samples"], dtype=float)
    x90_Q = np.asarray(
        config["waveforms"]["X90_wf_der_" + q_name]["samples"], dtype=float
    )

    # Y90 convention in your config: I <- Y90_wf_der_, Q <- Y90_wf_
    y90_phyI = np.asarray(
        config["waveforms"]["Y90_wf_der_" + q_name]["samples"], dtype=float
    )
    y90_phyQ = np.asarray(
        config["waveforms"]["Y90_wf_" + q_name]["samples"], dtype=float
    )

    def _fit_to_headroom(corr, headroom, channel):
        corr = np.asarray(corr, dtype=float)
        peak = float(np.max(np.abs(corr))) if len(corr) else 0.0
        if peak > headroom and peak > 0:
            scale = headroom / peak
            print(
                f"  WARNING: correction {channel} peak={peak:.4f} V > "
                f"headroom={headroom:.4f} V; rescaling by {scale:.4f}."
            )
            corr = corr * scale
        return corr

    crab_I_X = _fit_to_headroom(crab_wf_I_X, 0.5 - np.max(np.abs(x90_I)), "I_X")
    crab_Q_X = _fit_to_headroom(crab_wf_Q_X, 0.5 - np.max(np.abs(x90_Q)), "Q_X")
    crab_I_Y = _fit_to_headroom(crab_wf_I_Y, 0.5 - np.max(np.abs(y90_phyI)), "I_Y")
    crab_Q_Y = _fit_to_headroom(crab_wf_Q_Y, 0.5 - np.max(np.abs(y90_phyQ)), "Q_Y")

    x90_oc_phyI = x90_I + crab_I_X
    x90_oc_phyQ = x90_Q + crab_Q_X
    y90_oc_phyI = y90_phyI + crab_I_Y
    y90_oc_phyQ = y90_phyQ + crab_Q_Y

    # Store waveforms, preserving your original naming convention.
    config["waveforms"]["X90_OC_wf_" + q_name] = {
        "type": "arbitrary",
        "samples": x90_oc_phyI.tolist(),
    }
    config["waveforms"]["X90_OC_wf_der_" + q_name] = {
        "type": "arbitrary",
        "samples": x90_oc_phyQ.tolist(),
    }
    config["waveforms"]["mX90_OC_wf_" + q_name] = {
        "type": "arbitrary",
        "samples": (-x90_oc_phyI).tolist(),
    }
    config["waveforms"]["mX90_OC_wf_der_" + q_name] = {
        "type": "arbitrary",
        "samples": (-x90_oc_phyQ).tolist(),
    }

    config["waveforms"]["Y90_OC_wf_der_" + q_name] = {
        "type": "arbitrary",
        "samples": y90_oc_phyI.tolist(),
    }
    config["waveforms"]["Y90_OC_wf_" + q_name] = {
        "type": "arbitrary",
        "samples": y90_oc_phyQ.tolist(),
    }
    config["waveforms"]["mY90_OC_wf_der_" + q_name] = {
        "type": "arbitrary",
        "samples": (-y90_oc_phyI).tolist(),
    }
    config["waveforms"]["mY90_OC_wf_" + q_name] = {
        "type": "arbitrary",
        "samples": (-y90_oc_phyQ).tolist(),
    }

    def _add_pulse(name, wf_I_key, wf_Q_key):
        config["pulses"][name] = {
            "operation": "control",
            "length": len(config["waveforms"][wf_I_key]["samples"]),
            "waveforms": {"I": wf_I_key, "Q": wf_Q_key},
            "digital_marker": "trig",
        }

    _add_pulse(
        "X90_OC_pulse_" + q_name, "X90_OC_wf_" + q_name, "X90_OC_wf_der_" + q_name
    )
    _add_pulse(
        "mX90_OC_pulse_" + q_name, "mX90_OC_wf_" + q_name, "mX90_OC_wf_der_" + q_name
    )
    _add_pulse(
        "Y90_OC_pulse_" + q_name, "Y90_OC_wf_der_" + q_name, "Y90_OC_wf_" + q_name
    )
    _add_pulse(
        "mY90_OC_pulse_" + q_name, "mY90_OC_wf_der_" + q_name, "mY90_OC_wf_" + q_name
    )

    config["elements"][q_name]["operations"]["X90_OC"] = "X90_OC_pulse_" + q_name
    config["elements"][q_name]["operations"]["mX90_OC"] = "mX90_OC_pulse_" + q_name
    config["elements"][q_name]["operations"]["Y90_OC"] = "Y90_OC_pulse_" + q_name
    config["elements"][q_name]["operations"]["mY90_OC"] = "mY90_OC_pulse_" + q_name

    return config


# =============================================================================
# Physics-informed waveform basis
# =============================================================================


def get_base_x90_waveforms(config, q_name):
    """Return physical I/Q arrays for the base X90 pulse."""
    x90_I = np.asarray(config["waveforms"]["X90_wf_" + q_name]["samples"], dtype=float)
    x90_Q = np.asarray(
        config["waveforms"]["X90_wf_der_" + q_name]["samples"], dtype=float
    )
    return x90_I, x90_Q


def decode_physical_params(x, x90_amp, leak_freqs_mhz):
    """
    Decode unconstrained CMA vector into bounded physical parameters.

    Bounds are deliberately conservative. Increase only if you first see that
    good candidates are saturating tanh at +/-1.
    """
    x = np.asarray(x, dtype=float)
    n_required = 4 + 2 * len(leak_freqs_mhz)
    if len(x) != n_required:
        raise ValueError(f"Expected x length {n_required}, got {len(x)}")

    # Coherent/low-dimensional corrections.
    amp_frac_bound = 0.030  # +/-3% amplitude scale
    drag_frac_bound = 0.50  # +/-50% extra scaling of existing derivative quadrature
    phase_bound = 0.060  # constant small pulse-axis phase, rad-ish
    phase_ramp_bound = 0.080  # odd phase across pulse, rad-ish, detuning/Stark-like

    # Leakage tones are small additive voltages. For x90_amp ~ 0.006, this is ~75 uV.
    # If nothing moves and all tone params saturate, try x90_amp/50.
    tone_amp_bound = x90_amp / 80.0

    amp_frac = amp_frac_bound * np.tanh(x[0])
    drag_frac = drag_frac_bound * np.tanh(x[1])
    phase_const = phase_bound * np.tanh(x[2])
    phase_ramp = phase_ramp_bound * np.tanh(x[3])

    tone_coeffs = []
    idx = 4
    for f_mhz in leak_freqs_mhz:
        c_re = tone_amp_bound * np.tanh(x[idx])
        c_im = tone_amp_bound * np.tanh(x[idx + 1])
        tone_coeffs.append((float(f_mhz), float(c_re), float(c_im)))
        idx += 2

    return {
        "amp_frac": float(amp_frac),
        "drag_frac": float(drag_frac),
        "phase_const": float(phase_const),
        "phase_ramp": float(phase_ramp),
        "tone_coeffs": tone_coeffs,
    }


def make_physical_shared_xy_corrections(
    x, base_config, q_name, x90_amp, leak_freqs_mhz
):
    """
    Build correction waveforms from physically motivated modes.

    Returns physical-channel corrections:
      crab_wf_I_X, crab_wf_Q_X, crab_wf_I_Y, crab_wf_Q_Y

    Y correction is generated from X correction by +90 degree rotation:
      delta_z_Y = i * delta_z_X, so I_Y=-Q_X and Q_Y=I_X.
    If your Y convention is opposite, flip those two signs below.
    """
    x90_I, x90_Q = get_base_x90_waveforms(base_config, q_name)
    n = len(x90_I)
    if n != len(x90_Q):
        raise ValueError("X90 I/Q waveforms have different lengths")

    t = np.arange(n, dtype=float)  # ns samples
    tc = t - 0.5 * (n - 1)
    tc_norm = tc / np.max(np.abs(tc)) if n > 1 else tc

    # Window tones to avoid jumps at pulse boundaries.
    window = np.sin(np.pi * t / (n - 1)) ** 2 if n > 1 else np.ones(n)

    params = decode_physical_params(x, x90_amp, leak_freqs_mhz)
    amp_frac = params["amp_frac"]
    drag_frac = params["drag_frac"]
    phase_const = params["phase_const"]
    phase_ramp = params["phase_ramp"]

    corr_I = np.zeros(n, dtype=float)
    corr_Q = np.zeros(n, dtype=float)

    # 1) Amplitude/angle correction.
    corr_I += amp_frac * x90_I
    corr_Q += amp_frac * x90_Q

    # 2) DRAG/quadrature correction. Existing derivative quadrature is x90_Q.
    corr_Q += drag_frac * x90_Q

    # 3) Constant pulse-axis phase rotation. For z = I+iQ, dz ≈ i*phi*z.
    corr_I += -phase_const * x90_Q
    corr_Q += +phase_const * x90_I

    # 4) Intra-pulse phase ramp, detuning/Stark-like. Odd around pulse center.
    corr_I += -phase_ramp * tc_norm * x90_Q
    corr_Q += +phase_ramp * tc_norm * x90_I

    # 5) Windowed complex leakage-scale tones.
    for f_mhz, c_re, c_im in params["tone_coeffs"]:
        phase = 2 * np.pi * f_mhz * t / 1000.0  # f in MHz, t in ns
        tone = window * np.exp(1j * phase)
        corr = (c_re + 1j * c_im) * tone
        corr_I += np.real(corr)
        corr_Q += np.imag(corr)

    crab_wf_I_X = corr_I
    crab_wf_Q_X = corr_Q

    # Shared XY: Y correction is rotated by +90 degrees in IQ plane.
    crab_wf_I_Y = -corr_Q
    crab_wf_Q_Y = +corr_I

    return (
        crab_wf_I_X.tolist(),
        crab_wf_Q_X.tolist(),
        crab_wf_I_Y.tolist(),
        crab_wf_Q_Y.tolist(),
    )


def print_physical_params(label, x, x90_amp, leak_freqs_mhz):
    p = decode_physical_params(x, x90_amp, leak_freqs_mhz)
    print(f"\n[{label}] decoded physical parameters:")
    print(f"  amp_frac    = {p['amp_frac']:+.5e}")
    print(f"  drag_frac   = {p['drag_frac']:+.5e}")
    print(f"  phase_const = {p['phase_const']:+.5e}")
    print(f"  phase_ramp  = {p['phase_ramp']:+.5e}")
    print("  leakage-tone coeffs [MHz, Re[V], Im[V]]:")
    for f_mhz, c_re, c_im in p["tone_coeffs"]:
        print(f"    {f_mhz:7.1f}  {c_re:+.5e}  {c_im:+.5e}")


