    )
    print(
        f"Fast RB depths: {fast_circuit_depths}, shots={SHOTS_FAST}, circuits={NUM_CIRCUITS_FAST}"
    )
    print(
        f"Fast fit mode: {FAST_FIT_MODE}, fixed train seed: {RB_TRAIN_SEED if USE_FIXED_TRAIN_SEED else None}"
    )

    config = meta_dict_to_config_1Q(meta_dict)
    calib_params = {}

    # Single-shot calibration.
    if RUN_SS_CAL:
        print("Running single shot calibration...")
        SS = SingleShot1Q(
            qubit,
            SS_SHOTS,
            meta_dict=meta_dict,
            outer_folder=outer_folder,
            path=qubit,
            suffix="SS_Cal",
            config=config,
        )
        calib_params = SS.calib_params
        meta_dict["read_theta"] = SS.calib_params["read_theta"]
        config = meta_dict_to_config_1Q(meta_dict)
        print(SS.calib_params)

    long_rb_experiment_dict = {
        "RB": {
            "circuit_lengths": LONG_RB_LENGTHS,
            "num_circuits": NUM_CIRCUITS_LONG,
            "shots": SHOTS_LONG,
        }
    }

    # Baseline fast metric with zero correction.
    zero_x = np.zeros(n_cma_params)
    print("\nRunning baseline fast RB metric for zero correction...")
    baseline_feedback, baseline_probs = run_rb_fast_feedback_physical_x(
        x=zero_x,
        qubit=qubit,
        x90_amp=x90_amp,
        leak_freqs_mhz=leak_freqs_mhz,
        meta_dict=meta_dict,
        fast_circuit_depths=fast_circuit_depths,
        shots=SHOTS_FAST,
        num_circuits=NUM_CIRCUITS_FAST,
        calib_params=calib_params,
        outer_folder=crab_run_dir,
        iteration_label="baseline_fast",
        rb_seed=RB_TRAIN_SEED if USE_FIXED_TRAIN_SEED else None,
    )
    baseline_cost = 1.0 - baseline_feedback
    print(
        f"Baseline fast feedback metric: {baseline_feedback:.8f}  cost={baseline_cost:.8e}"
    )
    print(f"Baseline fast return probs: {baseline_probs}")

    print("\nRunning baseline long RB for zero correction...")
    baseline_long_fidelity, _ = run_rb_fidelity_physical_x(
        x=zero_x,
        qubit=qubit,
        x90_amp=x90_amp,
        leak_freqs_mhz=leak_freqs_mhz,
        meta_dict=meta_dict,
        experiment_dict=long_rb_experiment_dict,
        calib_params=calib_params,
        outer_folder=crab_run_dir,
        iteration_label="baseline_long",
        crab_dir=crab_run_dir,
        rb_seed=None,
    )
    print(f"Baseline long RB gate_fidelity = {baseline_long_fidelity:.8f}")

    evaluate, n_cma_params_check = make_evaluate_fast_physical(
        qubit=qubit,
        x90_amp=x90_amp,
        leak_freqs_mhz=leak_freqs_mhz,
        meta_dict=meta_dict,
        fast_circuit_depths=fast_circuit_depths,
        shots=SHOTS_FAST,
        num_circuits=NUM_CIRCUITS_FAST,
        calib_params=calib_params,
        outer_folder=crab_run_dir,
    )
    assert n_cma_params_check == n_cma_params

    es = cma.CMAEvolutionStrategy(
        np.zeros(n_cma_params),
        CMA_SIGMA0,
        {
            "maxiter": CMA_MAXITER,
            "popsize": int(4 + 3 * np.log(n_cma_params)),
            "tolfun": CMA_TOLFUN,
            "tolx": CMA_TOLX,
            "verbose": 3,
        },
    )

    history = []
    best_so_far_history = []
    sigma_history = []
    checkpoint_long_fids = []
    zero_long_fids = []
    iteration = 0

    fig, ax = plt.subplots(figsize=(10, 6))

    def run_long_rb_checkpoint(iteration_num, label):
        """RB-only checkpoint for xbest, optionally also current zero."""
        best_x = es.result.xbest

        print(f"\n[{label}] Running long RB checkpoint for current xbest...")
        print_physical_params(label, best_x, x90_amp, leak_freqs_mhz)
        ck_fidelity, _ = run_rb_fidelity_physical_x(
            x=best_x,
            qubit=qubit,
            x90_amp=x90_amp,
            leak_freqs_mhz=leak_freqs_mhz,
            meta_dict=meta_dict,
            experiment_dict=long_rb_experiment_dict,
            calib_params=calib_params,
            outer_folder=crab_run_dir,
            iteration_label=label,
            crab_dir=crab_run_dir,
            rb_seed=None,
        )
        print(f"[{label}] xbest long RB gate_fidelity = {ck_fidelity:.8f}")
        checkpoint_long_fids.append((iteration_num, ck_fidelity))

        if RUN_ZERO_LONG_RB_AT_CHECKPOINT:
            zero_label = f"{label}_zero"
            print(f"\n[{zero_label}] Running long RB checkpoint for zero correction...")
            zero_fidelity, _ = run_rb_fidelity_physical_x(
                x=zero_x,
                qubit=qubit,
                x90_amp=x90_amp,
                leak_freqs_mhz=leak_freqs_mhz,
                meta_dict=meta_dict,
                experiment_dict=long_rb_experiment_dict,
                calib_params=calib_params,
                outer_folder=crab_run_dir,
                iteration_label=zero_label,
                crab_dir=crab_run_dir,
                rb_seed=None,
            )
            print(f"[{zero_label}] zero long RB gate_fidelity = {zero_fidelity:.8f}")
            print(
                f"[{label}] xbest - zero long RB = {ck_fidelity - zero_fidelity:+.3e}"
            )
            zero_long_fids.append((iteration_num, zero_fidelity))

        return ck_fidelity

    # CMA loop.
    while not es.stop():
        solutions = es.ask()
        costs = [evaluate(x) for x in solutions]
        es.tell(solutions, costs)
        es.disp()

        generation_best = float(np.min(costs))
        history.append(generation_best)
        best_so_far_history.append(float(np.min(history)))
        sigma_history.append(float(es.sigma))
        iteration += 1

        print(f"\n{'─' * 72}")
        print(f"  History — generation best and overall best={es.result.fbest:.6e}")
        for i, (h, bsf, sig) in enumerate(
            zip(history, best_so_far_history, sigma_history)
        ):
            marker = " ◄" if h == min(history) else ""
            print(
                f"  Gen {i + 1:3d}: gen_best={h:.6e}  best_so_far={bsf:.6e}  "
                f"feedback={1.0 - bsf:.8f}  sigma={sig:.4f}{marker}"
            )
        print(f"{'─' * 72}\n")

        # Update convergence plot.
        ax.clear()
        ax.plot(
            history, marker="o", markersize=3, alpha=0.45, label="best in generation"
        )
        ax.plot(best_so_far_history, marker="o", markersize=3, label="best so far")
        ax.axhline(baseline_cost, color="gray", linestyle="--", label="baseline fast")
        ax.set_xlabel("CMA-ES iteration")
        ax.set_ylabel("Best cost (1 − fast RB feedback metric)")
        ax.set_yscale("log")
        ax.set_title(f"Physical-basis CRAB-OC — {qubit}  [iter {iteration}]")
        ax.legend()
        ax.grid()
        fig.tight_layout()
        fig.savefig(os.path.join(crab_run_dir, f"cma_convergence_physical_{qubit}.png"))

        if CHECKPOINT_EVERY and iteration % CHECKPOINT_EVERY == 0:
            run_long_rb_checkpoint(iteration, f"iter{iteration:04d}")

    plt.close(fig)

    # Final results.
    best_x = es.result.xbest
    best_fast_cost = float(es.result.fbest)
    best_fast_feedback = 1.0 - best_fast_cost

    print("\nFinal best parameters:")
    print_physical_params("final", best_x, x90_amp, leak_freqs_mhz)
    print(f"Baseline fast feedback: {baseline_feedback:.8f} cost={baseline_cost:.8e}")
    print(f"Best fast feedback    : {best_fast_feedback:.8f} cost={best_fast_cost:.8e}")
    print(f"Fast feedback improvement: {best_fast_feedback - baseline_feedback:+.3e}")
    print(f"Baseline long RB fidelity: {baseline_long_fidelity:.8f}")

    final_long_fidelity = run_long_rb_checkpoint(iteration, "final")
    print(f"Final xbest long RB fidelity: {final_long_fidelity:.8f}")
    print(
        f"Final xbest - baseline_long: {final_long_fidelity - baseline_long_fidelity:+.3e}"
    )

    # Save best parameters and correction waveforms.
    best_config, best_wfs = build_config_with_physical_x(
        best_x,
        meta_dict,
        qubit,
        x90_amp,
        leak_freqs_mhz,
    )

    np.savez(
        os.path.join(crab_run_dir, f"best_physical_crab_params_{qubit}.npz"),
        best_x=best_x,
        leak_freqs_mhz=leak_freqs_mhz,
        baseline_fast_feedback=baseline_feedback,
        baseline_fast_cost=baseline_cost,
        best_fast_feedback=best_fast_feedback,
        best_fast_cost=best_fast_cost,
        baseline_long_fidelity=baseline_long_fidelity,
        final_long_fidelity=final_long_fidelity,
        history=np.asarray(history),
        best_so_far_history=np.asarray(best_so_far_history),
        sigma_history=np.asarray(sigma_history),
        checkpoint_long_fids=np.asarray(checkpoint_long_fids, dtype=float),
        zero_long_fids=np.asarray(zero_long_fids, dtype=float),
        crab_wf_I_X=np.asarray(best_wfs[0]),
        crab_wf_Q_X=np.asarray(best_wfs[1]),
        crab_wf_I_Y=np.asarray(best_wfs[2]),
        crab_wf_Q_Y=np.asarray(best_wfs[3]),
    )

    print(
        f"Saved best physical-basis parameters to {crab_run_dir}/best_physical_crab_params_{qubit}.npz"
    )
