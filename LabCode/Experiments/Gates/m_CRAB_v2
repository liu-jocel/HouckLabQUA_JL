def set_rb_seed(seed):
    """Try to make RB sequence generation repeatable, if RB1Q_CRAB uses these RNGs."""
    if seed is not None:
        np.random.seed(seed)
        random.seed(seed)


def extract_return_prob_array(rb, n_expected):
    if hasattr(rb, "data") and isinstance(rb.data, dict) and "return_prob" in rb.data:
        arr = rb.data["return_prob"]
        if not isinstance(arr, (list, tuple, np.ndarray)):
            arr = [arr]
        arr = np.asarray(arr, dtype=float)
    else:
        print("  WARNING: RB object has no data['return_prob']; using 0.5 fallback.")
        arr = np.full(n_expected, 0.5, dtype=float)
    return arr


def fixed_floor_log_p_estimate(depths, probs, floor=0.5):
    """
    Stable p estimate from log(P-floor) = log(A) + depth*log(p).

    This is deliberately restrictive. It avoids a free SPAM/asymptote parameter,
    which was likely allowing the fast objective to produce false improvements.
    """
    depths = np.asarray(depths, dtype=float)
    probs = np.asarray(probs, dtype=float)
    y = probs - floor

    if len(depths) != len(probs):
        print(f"  WARNING: depth/prob length mismatch: {len(depths)} vs {len(probs)}")
        return 0.0
    if np.any(~np.isfinite(y)) or np.any(y <= 0.005):
        return 0.0

    try:
        slope, _ = np.polyfit(depths, np.log(y), 1)
        p = float(np.exp(slope))
        if not np.isfinite(p) or p < 0.90 or p > 1.0002:
            return 0.0
        return min(p, 1.0)
    except Exception as exc:
        print(f"  WARNING: fixed_floor_log_p_estimate failed: {exc}")
        return 0.0


def bounded_curve_fit_p_estimate(depths, probs):
    """
    Bounded 3-parameter RB fit. More flexible than fixed-floor log fit, but less
    robust with only a few depths.
    """
    depths = np.asarray(depths, dtype=float)
    probs = np.asarray(probs, dtype=float)

    def fitRB(x, a, p, b):
        return a * p**x + b

    try:
        popt, _ = curve_fit(
            fitRB,
            depths,
            probs,
            p0=[0.4, 0.999, 0.5],
            bounds=([0.02, 0.90, 0.35], [0.95, 1.0002, 0.65]),
            maxfev=5000,
        )
        p = float(popt[1])
        if not np.isfinite(p):
            return 0.0
        return min(p, 1.0)
    except Exception as exc:
        print(f"  WARNING: bounded_curve_fit_p_estimate failed: {exc}")
        return 0.0


def estimate_fast_metric(depths, probs, mode=FAST_FIT_MODE, floor=RB_FLOOR):
    if len(depths) == 1:
        return float(np.mean(probs))
    if mode == "fixed_floor_log":
        return fixed_floor_log_p_estimate(depths, probs, floor=floor)
    if mode == "bounded_curve_fit":
        return bounded_curve_fit_p_estimate(depths, probs)
    raise ValueError(f"Unknown FAST_FIT_MODE: {mode}")


def build_config_with_physical_x(x, meta_dict, q_name, x90_amp, leak_freqs_mhz):
    base_config = meta_dict_to_config_1Q(meta_dict)
    wfs = make_physical_shared_xy_corrections(
        x=x,
        base_config=base_config,
        q_name=q_name,
        x90_amp=x90_amp,
        leak_freqs_mhz=leak_freqs_mhz,
    )
    return add_x90_oc_to_config(base_config, q_name, *wfs), wfs


def run_rb_fast_feedback_physical_x(
    x,
    qubit,
    x90_amp,
    leak_freqs_mhz,
    meta_dict,
    fast_circuit_depths,
    shots,
    num_circuits,
    calib_params,
    outer_folder,
    iteration_label,
    rb_seed=None,
):
    config, _ = build_config_with_physical_x(
        x, meta_dict, qubit, x90_amp, leak_freqs_mhz
    )

    set_rb_seed(rb_seed)

    rb = RB1Q_CRAB(
        qubit,
        fast_circuit_depths,
        num_circuits,
        shots,
        calib_params,
        meta_dict=meta_dict,
        outer_folder=outer_folder,
        path=qubit,
        suffix=f"RB_fast_{iteration_label}",
        config=config,
    )

    return_prob_array = extract_return_prob_array(rb, len(fast_circuit_depths))
    feedback_metric = estimate_fast_metric(fast_circuit_depths, return_prob_array)

    # Remove high-volume fast files.
    for attr in ["iname", "fname"]:
        if hasattr(rb, attr):
            f = getattr(rb, attr)
            if f and os.path.isfile(f):
                os.remove(f)

    return feedback_metric, return_prob_array


def run_rb_fidelity_physical_x(
    x,
    qubit,
    x90_amp,
    leak_freqs_mhz,
    meta_dict,
    experiment_dict,
    calib_params,
    outer_folder,
    iteration_label,
    crab_dir=None,
    rb_seed=None,
):
    """Run full/long RB for a physical-basis parameter vector x."""
    config, _ = build_config_with_physical_x(
        x, meta_dict, qubit, x90_amp, leak_freqs_mhz
    )

    set_rb_seed(rb_seed)

    rb = RB1Q_CRAB(
        qubit,
        experiment_dict["RB"]["circuit_lengths"],
        experiment_dict["RB"]["num_circuits"],
        experiment_dict["RB"]["shots"],
        calib_params,
        meta_dict=meta_dict,
        outer_folder=outer_folder,
        path=qubit,
        suffix=f"RB_OC_{iteration_label}",
        config=config,
    )

    # Move the figure into the CRAB run dir if available.
    if (
        crab_dir is not None
        and hasattr(rb, "iname")
        and rb.iname
        and os.path.isfile(rb.iname)
    ):
        shutil.move(rb.iname, os.path.join(crab_dir, os.path.basename(rb.iname)))

    return rb.gate_fidelity(), crab_dir if crab_dir is not None else os.path.dirname(
        getattr(rb, "iname", outer_folder)
    )


